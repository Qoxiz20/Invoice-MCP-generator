# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# ============================================================
# Supabase - used for the invoice number counter (unrelated to MCP)
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ============================================================
# Google Cloud OAuth Client - SAME client used for two SEPARATE purposes:
#   1. src/auth.js - the server's own long-lived Drive/Sheets access
#      (refresh-token flow, unattended, used by generate-invoice.js AND
#      the sheets_*/drive_* MCP tools)
#   2. lib/google-identity.js - a one-time interactive login used ONLY
#      inside /api/authorize to confirm "is this really you" before this
#      app issues its own MCP access token. Google's token from this flow
#      is never sent to Claude.
#
# Because of purpose #2, this Google Cloud OAuth Client needs an
# ADDITIONAL Authorized redirect URI added, alongside whatever's already
# there for get-refresh-token.js:
#   {MCP_ISSUER_URL}/api/oauth/google/callback
# (see MCP_ISSUER_URL below for what that resolves to)
# ============================================================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ============================================================
# This app's own Authorization Server (new)
# ============================================================

# The canonical, stable URL this app is deployed at. MUST be set to your
# real production domain (not a Vercel preview URL, which changes per
# deploy) - it's used to construct the issuer, resource, and redirect URIs
# consistently everywhere. Example: https://lhg-mcp.vercel.app
MCP_ISSUER_URL=http://localhost:3000

# A long random string (32+ characters) used to sign every token this app
# issues (authorization codes, access tokens, refresh tokens, relay state).
# Generate one with: openssl rand -base64 48
# Rotating this value immediately invalidates every outstanding token -
# that's the only way to revoke access with this stateless design.
MCP_JWT_SECRET=

# A Client ID and Secret YOU make up (not from Google) - these are what
# you'll paste into Claude's "Use your own OAuth client" field when adding
# this as a custom connector. Any random strings work.
# Generate with: openssl rand -hex 16
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=

# The ONLY Google account allowed to complete the /authorize flow and use
# this connector. Case-insensitive comparison.
ALLOWED_GOOGLE_EMAIL=

# ============================================================
# WhatsApp Cloud API - not needed until Meta approval lands
# ============================================================
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
